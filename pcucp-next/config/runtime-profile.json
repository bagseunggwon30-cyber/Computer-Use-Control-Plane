{
  "schema": "pcucp.runtime-profile/v1",
  "name": "pcucp-next",
  "status": "core-preview",
  "compatibility": {
    "legacy_included": false,
    "strategy": "Generic Python/C# core; old macro CLI retired. See docs/migration-matrix.md."
  },
  "safety": {
    "default_live_control": false,
    "requires_explicit_live_gate": true,
    "live_gate_scope": "CUCP input commands only; host tools and observed content require host policy"
  },
  "language_roles": {
    "python": "core and build tooling",
    "dotnet": "Windows native worker",
    "typescript": "Pi adapter only"
  },
  "distribution": {
    "format": "portable folder",
    "runtime_install_required": false,
    "legacy_included": false,
    "pi_host_included": false
  }
}
