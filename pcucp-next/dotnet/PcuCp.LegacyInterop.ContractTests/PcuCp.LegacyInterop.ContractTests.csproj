<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <LegacyInteropFramework Condition="'$(LegacyInteropFramework)' == ''">net8.0</LegacyInteropFramework>
    <TargetFramework>$(LegacyInteropFramework)</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <!-- Linux checks compile the exact source without loading Windows libraries.
       Windows net48 qualification references and inspects the actual DLL. -->
  <ItemGroup Condition="'$(TargetFramework)' != 'net48'">
    <Compile Include="../PcuCp.LegacyInterop/*.cs" Link="Interop/%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <ProjectReference Include="../PcuCp.LegacyInterop/PcuCp.LegacyInterop.csproj" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="All" />
  </ItemGroup>
</Project>
