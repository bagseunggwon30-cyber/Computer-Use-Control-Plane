<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net48</TargetFramework><LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable><ImplicitUsings>disable</ImplicitUsings><Prefer32Bit>false</Prefer32Bit>
    <Deterministic>true</Deterministic><TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System.Web.Extensions" />
    <!-- Read-only PS5 syntax compatibility. Never copied from Windows into a
         release, never creates a pipeline/runspace or executes token content. -->
    <Reference Include="System.Management.Automation">
      <HintPath>$(WINDIR)\Microsoft.NET\assembly\GAC_MSIL\System.Management.Automation\v4.0_3.0.0.0__31bf3856ad364e35\System.Management.Automation.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="All" />
  </ItemGroup>
</Project>
