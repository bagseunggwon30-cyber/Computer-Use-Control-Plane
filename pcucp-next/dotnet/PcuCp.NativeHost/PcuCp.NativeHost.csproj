<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>PcuCp.NativeHost</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../PcuCp.LegacyInterop/*.cs" Link="LegacyInterop/%(Filename)%(Extension)" />
    <Compile Remove="LegacyWorkflowLiteralParser.cs" />
    <Compile Include="../PcuCp.LegacyExecution/*.cs" Link="LegacyExecution/%(Filename)%(Extension)" />
    <Compile Include="../PcuCp.LegacyInteraction/*.cs" Link="LegacyInteraction/%(Filename)%(Extension)" />
    <Compile Include="../PcuCp.LegacyDiagnostics/*.cs" Link="LegacyDiagnostics/%(Filename)%(Extension)" />
    <Compile Include="../PcuCp.LegacyPrecision/*.cs" Link="LegacyPrecision/%(Filename)%(Extension)" />
    <Compile Include="../PcuCp.LegacyTaskPreset/LegacyTaskPresetKernel.cs" Link="LegacyTaskPresetKernel.cs" />
    <Compile Include="../PcuCp.LegacyTaskForm/LegacyTaskFormKernel.cs" Link="LegacyTaskFormKernel.cs" />
    <Compile Include="../PcuCp.LegacySmartPlan/LegacySmartPlanKernel.cs" Link="LegacySmartPlanKernel.cs" />
    <Compile Include="../PcuCp.LegacyAppProfile/LegacyAppProfileKernel.cs" Link="LegacyAppProfileKernel.cs" />
    <Compile Include="../PcuCp.LegacyAppProfile/LegacyAppProfileController.cs" Link="LegacyAppProfileController.cs" />
  </ItemGroup>
</Project>
